// Point the Jenkins job's "Script Path" at this file; the workspace is the repository root.
pipeline {
    agent any

    environment {
        DOTNET = "${WORKSPACE}\\.dotnet\\dotnet.exe"
        PROJECT = '016-Workshop-Building-a-CI-System-with-Selenium-and-Appium-Automated-Tests/SeleniumIdeTests/SeleniumIdeTests.csproj'
    }

    stages {
        stage("Checkout code") {
            //checkout repository
            steps {
                checkout scm
            }

        }
        stage("Setup .Net Core") {
            //install dotnet
            steps {
                bat '''
                echo Installing .Net Sdk 10.0
                powershell -NoProfile -ExecutionPolicy Bypass -Command "& ([scriptblock]::Create((Invoke-WebRequest -UseBasicParsing https://dot.net/v1/dotnet-install.ps1))) -Channel 10.0 -InstallDir '%WORKSPACE%\\.dotnet'"
                '''
            }

        }
        stage("Restore dependencies") {
            //install dependencies
            steps {
                bat '"%DOTNET%" restore %PROJECT%'
            }

        }
        stage("Build") {
            //build
            steps {
                bat '"%DOTNET%" build %PROJECT% --configuration Release'
            }

        }
        stage("Run Tests") {
            //run tests
            steps {
                bat '"%DOTNET%" test %PROJECT% --configuration Release --logger "trx;LogFileName=TestResults.trx"'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "**/TestResults/*.trx", allowEmptyArchive: true
            step([
                $class: 'MSTestPublisher',
                testResultsFile: "**/TestResults/*.trx"
            ])
        }
    }
}
